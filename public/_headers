/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  # Pitch demo: never indexed. Remove on handover, with robots.txt and the meta tags.
  X-Robots-Tag: noindex, nofollow

# Static assets are safe to cache hard - change the filename (or ?v=) to bust.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# HTML must stay fresh so a deploy is visible immediately.
/*.html
  Cache-Control: public, max-age=0, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate

/offer/
  Cache-Control: public, max-age=0, must-revalidate
